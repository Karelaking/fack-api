# ─── Fack API's Configuration ──────────────────────────────────────────────────
#
# Every key below is OPTIONAL for local development. With no keys set, Fack
# runs in LOCAL mode: all project data (projects, notes, settings) is stored
# in a private SQLite file on this machine and never leaves it.

# The environment the application is running in (development, production, or test)
NODE_ENV=development

# The port the Next.js server will listen on
PORT=3000

# ─── Storage (Local ↔ Cloud) ─────────────────────────────────────────────────
# Leave DATABASE_URL empty for LOCAL mode: the database is stored in the OS
# app-data directory — %APPDATA%\fack-api (Windows), ~/Library/Application
# Support/fack-api (macOS), ~/.local/share/fack-api (Linux). A database in
# the legacy .\data\fack.db location is migrated there automatically.
DATABASE_URL=""
DATABASE_AUTH_TOKEN=""

# Cloud mode: point DATABASE_URL at a remote libSQL/Turso database and set
# DATABASE_AUTH_TOKEN. The same code and data work in both modes, and
# Settings → Storage & Data can copy data between them.
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="eyJ..."

# Optional override for where local data (database, config, backups) lives.
# Leave empty to use the OS app-data directory described above.
FACK_DATA_DIR=""

# Force a storage mode. Leave empty to derive it automatically from
# DATABASE_URL (local unless a remote URL + token are configured).
STORAGE_MODE=""

# ─── Privacy ─────────────────────────────────────────────────────────────────
# In local mode nothing leaves this machine. Auth tokens are never logged and
# never returned by the API — Storage & Data only shows masked values.
# Database backups are written to <data dir>\backups\ as plain JSON files.

# Optional Postgres URL (Supabase/Neon) used for high-volume request logging.
# Leave empty and request logs are kept in the local database instead.
LOGS_POSTGRES_URL=""

# Logger verbosity (consola levels: 0 = fatal ... 5 = trace)
LOG_LEVEL=3

# ─── Authentication (Clerk) ────────────────────────────────────────────────────
# Create a project at https://dashboard.clerk.com and copy the keys below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Paths to the app's own sign-in / sign-up pages.
# REQUIRED: Clerk's server-side helpers (e.g. `auth.protect()` in a layout)
# resolve their redirect target from these. If they are unset, Clerk falls back
# to the hosted Account Portal, so unauthenticated visits to /dashboard land on
# the prebuilt Clerk pages instead of the in-app ones.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── Mock Auth Simulation ──────────────────────────────────────────────────────
# HMAC secret used to sign/verify simulated mock Bearer tokens.
# REQUIRED in production; in development it falls back to the project id.
JWT_SECRET=""

# ─── Domains & Subdomain Routing ───────────────────────────────────────────────
# Base domain used to resolve <slug>.<domain> mock namespaces.
APP_DOMAIN=""
NEXT_PUBLIC_APP_DOMAIN=""
# Absolute URL of the app (used for metadata/Open Graph).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── AI Providers (API Architect) ──────────────────────────────────────────────
# At least one provider key is recommended for real generation.
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
